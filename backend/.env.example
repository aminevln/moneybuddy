# ============================================================
# MoneyBuddy Backend - Environment Variables Template
# ============================================================
# Copia questo file come `.env` e riempi i valori reali.
# In produzione (Railway), questi valori vanno nelle env vars del servizio.
# ============================================================

# ============================================================
# APP
# ============================================================
ENVIRONMENT=development           # development | staging | production
DEBUG=true                        # false in produzione

# ============================================================
# DATABASE
# ============================================================
# Locale (docker-compose): postgresql+asyncpg://moneybuddy:moneybuddy_dev_password@localhost:5432/moneybuddy
# Railway fornisce automaticamente DATABASE_URL quando aggiungi il plugin Postgres,
# MA Railway dà il formato `postgresql://...` mentre noi vogliamo `postgresql+asyncpg://...`.
# In produzione sostituisci a mano `postgresql://` con `postgresql+asyncpg://`.
DATABASE_URL=postgresql+asyncpg://moneybuddy:moneybuddy_dev_password@localhost:5432/moneybuddy

# ============================================================
# SECURITY / AUTH
# ============================================================
# In produzione genera con: openssl rand -hex 32
SECRET_KEY=change-me-with-a-real-random-string-in-production

# ============================================================
# AI / LLM
# ============================================================
# Ottieni la chiave da https://aistudio.google.com/apikey
GOOGLE_API_KEY=AIzaSyBbNt93WAu-cC_ocJzLJpURJ1itNZsS1kc

# ============================================================
# CORS
# ============================================================
# Origini extra autorizzate (oltre a localhost), comma-separated.
# In dev: il tuo IP per testare via rete (es. iPhone su hotspot)
# In prod: l'URL Vercel del frontend
# Esempio dev:  EXTRA_CORS_ORIGINS=http://172.20.10.4:3000
# Esempio prod: EXTRA_CORS_ORIGINS=https://moneybuddy.vercel.app
EXTRA_CORS_ORIGINS=